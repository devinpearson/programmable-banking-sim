PORT=3000
AUTH=false
CLIENT_ID=
CLIENT_SECRET=
API_KEY=
TOKEN_EXPIRY=1799
DATABASE_URL="file:./dev.db"
# Where the dashboard and OAuth login/consent pages run (the web/ app)
WEB_URL=http://localhost:3001
# Sign-in and /identity requests allowed per minute per IP (default 300)
AUTH_RATE_LIMIT=300
# Webhook retry delays after a failed delivery, in ms (default 5000,30000,120000; empty = no retries)
# WEBHOOK_RETRY_DELAYS_MS=5000,30000,120000
