{
  "name": "programmable-banking-sim",
  "version": "1.2.0",
  "description": "Local Simulation of the api service. for local testing and demo purposes",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx --watch ./src/index.ts --tsconfig ./tsconfig.json",
    "dev:web": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
    "serve": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"tsx ./src/index.ts --tsconfig ./tsconfig.json\" \"npm --prefix web start\"",
    "build": "npx tsc",
    "db:reset": "npx prisma migrate reset --force",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "knip": "knip",
    "mutate": "stryker run"
  },
  "bin": {
    "pbsim": "dist/src/index.js"
  },
  "author": "Devin Pearson",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "programmable-banking-faker": "^1.0.2",
    "programmable-card-code-emulator": "^1.2.0",
    "socket.io": "^4.7.5",
    "typescript": "^5.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/chai": "^4.3.17",
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "chai": "^5.1.1",
    "concurrently": "^10.0.7",
    "jest": "^30.5.2",
    "knip": "^6.44.1",
    "prisma": "^5.17.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
